    {"name": "larger remainder wins", "total": 10, "weights": [1, 2], "expected": [3, 7]},
    {"name": "nothing to allocate", "total": 0, "weights": [5, 5], "expected": [0, 0]},
    {"name": "no weight at all", "total": 7, "weights": [0, 0], "expected": [0, 0]},
    {"name": "a zero weight takes nothing", "total": 7, "weights": [5, 0, 5], "expected": [4, 0, 3]},
    {"name": "empty", "total": 0, "weights": [], "expected": []}
