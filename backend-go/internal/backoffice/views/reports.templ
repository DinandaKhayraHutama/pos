package views

import (
	"bytes"
	"context"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/daniryckidinata/nti_pos/backend-go/internal/domain/reporting"
)

type ReportView struct {
	Filter    reporting.Filter
	Outlets   []Option
	Report    reporting.Report
	HasReport bool
	Location  *time.Location
	Form      Form
	Exports   []reporting.Export
}

type ScheduleView struct {
	Schedules []reporting.Schedule
	Outlets   []Option
	Location  *time.Location
	Form      Form
}

type DashboardView struct {
	// Preset is which period button is lit; Filter is what it resolved to.
	Preset string
	Filter reporting.Filter
	// Current and Previous cover the same NUMBER OF DAYS, so a 31-day month is
	// never compared against a 28-day one.
	Current   reporting.Report
	Previous  reporting.Report
	HasReport bool
	// ShowCosts is viewFinancialReports. When it is false the reports above
	// have already had cost and profit removed — this only decides whether to
	// leave a gap where they would have been.
	ShowCosts bool
	Outlets   []Option
	Location  *time.Location
	Form      Form
}

// RenderReportHTML renders the standalone printable report a PDF export is
// made from: the same ReportBody the Backoffice page shows.
func RenderReportHTML(ctx context.Context, r reporting.Report) ([]byte, error) {
	var buf bytes.Buffer
	err := ReportPrintPage(r).Render(ctx, &buf)
	return buf.Bytes(), err
}

// DateValue is a calendar date as an <input type="date"> reads it.
func DateValue(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format(time.DateOnly)
}

func reportLoc(r reporting.Report) *time.Location {
	if r.Timezone == "" {
		return time.UTC
	}
	loc, err := time.LoadLocation(r.Timezone)
	if err != nil {
		return time.UTC
	}
	return loc
}

func reportComputed(r reporting.Report) string {
	if r.ComputedAt == nil {
		return "belum ada data"
	}
	return r.ComputedAt.In(reportLoc(r)).Format("02 Jan 2006 15:04 MST")
}

func reportPeriod(r reporting.Report) string {
	if r.From.Equal(r.To) {
		return r.From.Format("02 Jan 2006")
	}
	return r.From.Format("02 Jan 2006") + " s.d. " + r.To.Format("02 Jan 2006")
}

func reportOutlet(r reporting.Report) string {
	if r.OutletName == "" {
		return "Semua outlet"
	}
	return r.OutletName
}

func reportPct(v float64) string { return strconv.FormatFloat(v, 'f', 1, 64) + "%" }

func reportCount(n int64) string { return strconv.FormatInt(n, 10) }

func reportShare(v, total int64) string {
	if total <= 0 {
		return reportPct(0)
	}
	return reportPct(float64(v) * 100 / float64(total))
}

// reportMax is a progress bar's maximum, never zero.
func reportMax(values ...int64) string {
	m := int64(1)
	for _, v := range values {
		if v > m {
			m = v
		}
	}
	return strconv.FormatInt(m, 10)
}

// Every bar below is scaled against the same column it draws, so a chart and
// the number beside it are never two different measures.
func dailyMax(r reporting.Report) string {
	vals := make([]int64, len(r.Daily))
	for i, d := range r.Daily {
		vals[i] = d.NetSales
	}
	return reportMax(vals...)
}

func hourMax(r reporting.Report) string {
	vals := make([]int64, len(r.ByHour))
	for i, h := range r.ByHour {
		vals[i] = h.NetSales
	}
	return reportMax(vals...)
}

func weekdayMax(r reporting.Report) string {
	vals := make([]int64, len(r.ByWeekday))
	for i, w := range r.ByWeekday {
		vals[i] = w.NetSales
	}
	return reportMax(vals...)
}

func outletMax(r reporting.Report) string {
	vals := make([]int64, len(r.ByOutlet))
	for i, o := range r.ByOutlet {
		vals[i] = o.Net
	}
	return reportMax(vals...)
}

// reportMargin writes an em dash when there are no sales to divide by: a
// margin over nothing is undefined, and "0,0%" reads as a bad day.
func reportMargin(r reporting.Report) string {
	margin, ok := r.GrossMargin()
	if !ok {
		return "—"
	}
	return reportPct(margin)
}

func groupLabel(g reporting.CategoryProducts) string {
	return reporting.CategoryLabel(reporting.CategorySales{Key: g.CategoryKey, Name: g.CategoryName})
}

const reportProductLimit = 50

func reportProducts(r reporting.Report) []reporting.ProductLine {
	if len(r.ByProduct) > reportProductLimit {
		return r.ByProduct[:reportProductLimit]
	}
	return r.ByProduct
}

// WithAllOutlets puts "every outlet" first in an outlet select.
func WithAllOutlets(options []Option) []Option {
	return append([]Option{{Value: "", Label: "Semua outlet"}}, options...)
}

var ReportFormatOptions = []Option{
	{Value: reporting.FormatCSV, Label: "CSV"},
	{Value: reporting.FormatXLSX, Label: "Excel (XLSX)"},
	{Value: reporting.FormatPDF, Label: "PDF"},
}

var ReportFrequencyOptions = []Option{
	{Value: reporting.FrequencyDaily, Label: "Harian (kemarin)"},
	{Value: reporting.FrequencyWeekly, Label: "Mingguan (Senin–Minggu lalu)"},
	{Value: reporting.FrequencyMonthly, Label: "Bulanan (bulan lalu)"},
}

func frequencyLabel(f string) string {
	switch f {
	case reporting.FrequencyDaily:
		return "Harian"
	case reporting.FrequencyWeekly:
		return "Mingguan"
	case reporting.FrequencyMonthly:
		return "Bulanan"
	}
	return f
}

func exportStatusLabel(e reporting.Export) string {
	switch e.Status {
	case reporting.ExportQueued:
		return "menunggu"
	case reporting.ExportRunning:
		return "diproses"
	case reporting.ExportDone:
		return "siap"
	case reporting.ExportFailed:
		return "gagal"
	}
	return e.Status
}

func exportPoll(list []reporting.Export) templ.Attributes {
	for _, e := range list {
		if e.Status == reporting.ExportQueued || e.Status == reporting.ExportRunning {
			return templ.Attributes{"hx-get": "/backoffice/reports/exports", "hx-trigger": "every 5s", "hx-swap": "outerHTML"}
		}
	}
	return templ.Attributes{}
}

func exportPeriod(e reporting.Export) string {
	return e.From.Format(time.DateOnly) + " s.d. " + e.To.Format(time.DateOnly)
}

func exportOutlet(e reporting.Export) string {
	if e.OutletName == "" {
		return "Semua outlet"
	}
	return e.OutletName
}

func localTime(t time.Time, loc *time.Location) string {
	if loc == nil {
		loc = time.UTC
	}
	return t.In(loc).Format("02 Jan 15:04")
}

func byteLabel(n int64) string {
	switch {
	case n >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(n)/(1<<20))
	case n >= 1<<10:
		return fmt.Sprintf("%.0f KB", float64(n)/(1<<10))
	}
	return strconv.FormatInt(n, 10) + " B"
}

func scheduleOutlet(s reporting.Schedule) string {
	if s.OutletName == "" {
		return "Semua outlet"
	}
	return s.OutletName
}

// deltaLabel compares against the previous period of the same length.
//
// A zero base is written as "—", never as a percentage: there is nothing to
// compare against, and a made-up 100% turns a first day of trade into a
// triumph and a first quiet day into a collapse.
func deltaLabel(current, previous int64) string {
	change, ok := reporting.Change(current, previous)
	if !ok {
		if current == 0 {
			return "— tidak ada pembanding"
		}
		return "— periode sebelumnya kosong"
	}
	sign := "+"
	if change < 0 {
		sign = ""
	}
	return sign + strconv.FormatFloat(change, 'f', 1, 64) + "% dari periode sebelumnya"
}

// dashboardQuery keeps the chosen outlet when the period button changes: the
// two filters are independent, and resetting one from the other is the kind of
// small surprise that makes people stop trusting a dashboard.
func dashboardQuery(v DashboardView, preset string) string {
	q := url.Values{"period": {preset}}
	setIf(q, "outlet", v.Filter.OutletID)
	return "/backoffice/dashboard?" + q.Encode()
}

// dashboardTilesQuery is the refresh URL, carrying the resolved range rather
// than the preset — otherwise "hari ini" would silently roll over at midnight
// on a screen somebody left open, mid-comparison.
func dashboardTilesQuery(v DashboardView) string {
	q := url.Values{
		"period": {reporting.PeriodCustom},
		"from":   {DateValue(v.Filter.From)},
		"to":     {DateValue(v.Filter.To)},
	}
	setIf(q, "outlet", v.Filter.OutletID)
	return "/backoffice/dashboard/tiles?" + q.Encode()
}

func periodClass(active, preset string) string {
	if active == preset {
		return "button primary"
	}
	return "button"
}

templ reportStyles() {
	<style>
		.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin: 12px 0; }
		.tile { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px 14px; }
		.tile .value { font-size: 20px; font-weight: 700; margin-top: 4px; }
		.report-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 12px; }
		progress.share { width: 100%; height: 8px; }
	</style>
}

templ ReportsPage(s Session, v ReportView) {
	@Shell("Laporan", s) {
		@reportStyles()
		<h1>Laporan penjualan</h1>
		<p class="sub">
			Dibaca dari rollup harian per outlet, tidak pernah dari tabel order. Pendapatan mengikuti till:
			order yang dibatalkan dan direfund tidak dihitung.
		</p>
		<div class="card">
			<form method="get" action="/backoffice/reports" class="inline">
				@Field(v.Form, "Dari", "from", "date", templ.Attributes{"required": true})
				@Field(v.Form, "Sampai", "to", "date", templ.Attributes{"required": true})
				@Select(v.Form, "Outlet", "outlet", WithAllOutlets(v.Outlets))
				<button type="submit" class="primary">Tampilkan</button>
				if s.CanExports {
					<a href="/backoffice/reports/schedules">Jadwal kirim</a>
				}
			</form>
		</div>
		if v.HasReport {
			@ReportFreshness(v)
			@ReportBody(v.Report)
			if s.CanExports {
				<div class="card">
					<h2>Ekspor</h2>
					<form class="inline" hx-post="/backoffice/reports/exports" hx-target="#exports" hx-swap="outerHTML">
						<input type="hidden" name="from" value={ DateValue(v.Filter.From) }/>
						<input type="hidden" name="to" value={ DateValue(v.Filter.To) }/>
						<input type="hidden" name="outlet" value={ v.Filter.OutletID }/>
						@Select(NewForm(), "Format", "format", ReportFormatOptions)
						<button type="submit" class="primary">Buat ekspor</button>
					</form>
				</div>
			}
		}
		// The export list polls its own route; with the module off that route is
		// a 404, and polling it would raise an error toast every five seconds.
		if s.CanExports {
			@ExportsCard(v.Exports, v.Location)
		}
	}
}

templ ReportFreshness(v ReportView) {
	<div id="freshness" class="card">
		<p>
			Data per <strong>{ reportComputed(v.Report) }</strong>.
			if v.Report.PendingSlices > 0 {
				<span class="badge off">{ reportCount(v.Report.PendingSlices) } hari-outlet sedang diperbarui</span>
			}
		</p>
		<form
			hx-post="/backoffice/reports/recompute"
			hx-target="#freshness"
			hx-swap="outerHTML"
			hx-confirm="Hitung ulang rollup untuk rentang dan outlet ini? Hasilnya muncul dalam beberapa menit."
		>
			<input type="hidden" name="from" value={ DateValue(v.Filter.From) }/>
			<input type="hidden" name="to" value={ DateValue(v.Filter.To) }/>
			<input type="hidden" name="outlet" value={ v.Filter.OutletID }/>
			<button type="submit">Hitung ulang</button>
		</form>
	</div>
}

templ RecomputeNotice(message string) {
	<div id="freshness" class="card">
		<p>{ message }</p>
	</div>
}

templ reportTile(label, value, detail string) {
	<div class="tile">
		<div class="sub">{ label }</div>
		<div class="value">{ value }</div>
		if detail != "" {
			<div class="hint">{ detail }</div>
		}
	</div>
}

// ReportBody is the report itself. The Backoffice page and the PDF render the
// same component, so the two can never disagree about what a report shows.
templ ReportBody(r reporting.Report) {
	if r.Incomplete() {
		<p class="notice">
			{ reportCount(r.LegacySlices) } hari-outlet pada rentang ini masih memakai rumus lama, jadi
			waterfall di bawah belum lengkap. Angka akan benar sendiri setelah perhitungan ulang selesai.
		</p>
	}
	<div class="tiles">
		@reportTile("Penjualan bersih", Rupiah(r.NetSales), reportPeriod(r))
		@reportTile("Total penerimaan", Rupiah(r.Revenue), "termasuk pajak & service")
		@reportTile("Order", reportCount(r.OrderCount), "")
		@reportTile("Rata-rata penjualan", Rupiah(r.AverageOrder), "per order")
		@reportTile("Laba kotor", Rupiah(r.GrossProfit), "HPP "+Rupiah(r.CostOfGoods))
		@reportTile("Margin kotor", reportMargin(r), "atas penjualan bersih")
	</div>
	// The waterfall is a table rather than tiles on purpose: these figures are
	// read down a column, each one produced from the line above it, and tiles
	// say nothing about that order.
	<div class="card">
		<h2>Waterfall penjualan</h2>
		<p class="sub">
			Penjualan kotor mencakup transaksi yang kemudian direfund; refund muncul sebagai retur,
			bukan sebagai hari yang menyusut. Pajak dan service charge menaikkan penerimaan, bukan laba.
		</p>
		<table>
			<tbody>
				<tr><td>Penjualan kotor</td><td class="num">{ Rupiah(r.GrossSales) }</td></tr>
				<tr>
					<td>Diskon</td>
					<td class="num">−{ Rupiah(r.AllDiscount) }</td>
				</tr>
				<tr><td>Retur penjualan</td><td class="num">−{ Rupiah(r.SalesReturns) }</td></tr>
				if r.TaxIncluded != 0 {
					<tr><td>Pajak termasuk harga</td><td class="num">−{ Rupiah(r.TaxIncluded) }</td></tr>
				}
				<tr><td><strong>Penjualan bersih</strong></td><td class="num"><strong>{ Rupiah(r.NetSales) }</strong></td></tr>
				<tr><td>Pajak (PB1)</td><td class="num">+{ Rupiah(r.Tax) }</td></tr>
				<tr><td>Service charge</td><td class="num">+{ Rupiah(r.ServiceCharge) }</td></tr>
				if r.Rounding != 0 {
					<tr><td>Pembulatan</td><td class="num">{ Rupiah(r.Rounding) }</td></tr>
				}
				<tr><td><strong>Total penerimaan penjualan</strong></td><td class="num"><strong>{ Rupiah(r.Revenue) }</strong></td></tr>
				<tr><td>HPP</td><td class="num">−{ Rupiah(r.CostOfGoods) }</td></tr>
				<tr><td><strong>Laba kotor</strong></td><td class="num"><strong>{ Rupiah(r.GrossProfit) }</strong></td></tr>
			</tbody>
		</table>
		<p class="hint">
			Dibatalkan { Rupiah(r.CancelledAmount) } ({ reportCount(r.CancelledCount) } order) ditampilkan terpisah
			dan tidak dikurangkan lagi. Uang refund yang dikembalikan { Rupiah(r.RefundedAmount) }
			({ reportCount(r.RefundedCount) } order) berbeda dari retur penjualan karena pajak ikut dikembalikan.
			Order berdiskon { reportCount(r.DiscountedOrders) }.
			if r.AnomalyCount > 0 {
				{ reportCount(r.AnomalyCount) } order punya nominal yang tidak konsisten; lihat
				<code>justclick diagnostics reports</code>.
			}
		</p>
	</div>
	if r.CostCoverageLow() {
		<p class="notice">
			Hanya { reportPct(r.CostCoverage * 100) } item terjual yang punya HPP. Laba kotor belum bisa dipercaya
			sampai HPP produk dilengkapi.
		</p>
	}
	<div class="report-grid">
		<div class="card">
			<h2>Harian</h2>
			<table>
				<thead><tr><th>Tanggal</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th></th></tr></thead>
				<tbody>
					for _, d := range r.Daily {
						<tr>
							<td>{ DateValue(d.Date) }</td>
							<td class="num">{ Rupiah(d.NetSales) }</td>
							<td class="num">{ reportCount(d.Orders) }</td>
							<td><progress class="share" max={ dailyMax(r) } value={ reportCount(d.NetSales) }></progress></td>
						</tr>
					}
					if len(r.Daily) == 0 {
						<tr><td colspan="4" class="sub">Belum ada penjualan pada rentang ini.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Hari dalam minggu</h2>
			<p class="sub">
				Diturunkan dari tanggal bisnis, bukan dari jam server, sehingga penjualan lewat tengah malam
				tetap milik hari dagangnya. Kolom hari menyebut berapa kali hari itu benar-benar berdagang.
			</p>
			<table>
				<thead><tr><th>Hari</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th class="num">Hari</th><th></th></tr></thead>
				<tbody>
					for _, w := range r.ByWeekday {
						<tr>
							<td>{ reporting.Weekdays[w.Weekday] }</td>
							<td class="num">{ Rupiah(w.NetSales) }</td>
							<td class="num">{ reportCount(w.Orders) }</td>
							<td class="num">{ reportCount(w.Days) }</td>
							<td><progress class="share" max={ weekdayMax(r) } value={ reportCount(w.NetSales) }></progress></td>
						</tr>
					}
					if len(r.ByWeekday) == 0 {
						<tr><td colspan="5" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Per outlet</h2>
			<p class="sub">Diurutkan menurut penjualan bersih: cabang yang memungut service charge tidak otomatis unggul.</p>
			<table>
				<thead><tr><th>Outlet</th><th class="num">Penjualan bersih</th><th class="num">Penerimaan</th><th class="num">Order</th><th></th></tr></thead>
				<tbody>
					for _, o := range r.ByOutlet {
						<tr>
							<td>{ o.Label }</td>
							<td class="num">{ Rupiah(o.Net) }</td>
							<td class="num">{ Rupiah(o.Value) }</td>
							<td class="num">{ reportCount(o.Count) }</td>
							<td><progress class="share" max={ outletMax(r) } value={ reportCount(o.Net) }></progress></td>
						</tr>
					}
					if len(r.ByOutlet) == 0 {
						<tr><td colspan="5" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Per kategori</h2>
			<p class="sub">Penjualan bersih memikul diskon order dibagi largest-remainder; jumlahnya sama dengan subtotal dikurangi diskon.</p>
			<table>
				<thead><tr><th>Kategori</th><th class="num">Kotor</th><th class="num">Bersih</th><th class="num">Item</th><th class="num">Kontribusi</th></tr></thead>
				<tbody>
					for _, c := range r.ByCategory {
						<tr>
							<td>{ reporting.CategoryLabel(c) }</td>
							<td class="num">{ Rupiah(c.Gross) }</td>
							<td class="num">{ Rupiah(c.Net) }</td>
							<td class="num">{ reportCount(c.Items) }</td>
							<td class="num">{ reportPct(c.ContributionPercent) }</td>
						</tr>
					}
					if len(r.ByCategory) == 0 {
						<tr><td colspan="5" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Per brand</h2>
			<p class="sub">Transaksi sebelum dukungan brand tersedia tampil sebagai Tanpa brand.</p>
			<table>
				<thead><tr><th>Brand</th><th class="num">Kotor</th><th class="num">Bersih</th><th class="num">Item</th><th class="num">Kontribusi</th></tr></thead>
				<tbody>
					for _, b := range r.ByBrand {
						<tr><td>{ reporting.BrandLabel(b) }</td><td class="num">{ Rupiah(b.Gross) }</td><td class="num">{ Rupiah(b.Net) }</td><td class="num">{ reportCount(b.Items) }</td><td class="num">{ reportPct(b.ContributionPercent) }</td></tr>
					}
					if len(r.ByBrand) == 0 {
						<tr><td colspan="5" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Komposisi pembayaran</h2>
			<table>
				<thead><tr><th>Metode</th><th class="num">Pendapatan</th><th class="num">Order</th><th class="num">Porsi</th></tr></thead>
				<tbody>
					for _, p := range r.ByPayment {
						<tr>
							<td>{ p.Label }</td>
							<td class="num">{ Rupiah(p.Value) }</td>
							<td class="num">{ reportCount(p.Count) }</td>
							<td class="num">{ reportShare(p.Value, r.Revenue) }</td>
						</tr>
					}
					if len(r.ByPayment) == 0 {
						<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		if len(r.BySalesType) > 0 {
			<div class="card">
				<h2>Per jenis penjualan</h2>
				<table>
					<thead><tr><th>Jenis</th><th class="num">Penjualan bersih</th><th class="num">Pendapatan</th><th class="num">Order</th></tr></thead>
					<tbody>
						for _, st := range r.BySalesType {
							<tr>
								<td>{ SalesTypeLabel(st.Label) }</td>
								<td class="num">{ Rupiah(st.Net) }</td>
								<td class="num">{ Rupiah(st.Value) }</td>
								<td class="num">{ reportCount(st.Count) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="card">
			<h2>Per kasir</h2>
			<table>
				<thead><tr><th>Kasir</th><th class="num">Penjualan bersih</th><th class="num">Penerimaan</th><th class="num">Order</th></tr></thead>
				<tbody>
					for _, c := range r.ByCashier {
						<tr>
							<td>{ c.Label }</td>
							<td class="num">{ Rupiah(c.Net) }</td>
							<td class="num">{ Rupiah(c.Value) }</td>
							<td class="num">{ reportCount(c.Count) }</td>
						</tr>
					}
					if len(r.ByCashier) == 0 {
						<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card">
			<h2>Per jam</h2>
			<p class="sub">Jam mengikuti zona waktu merchant ({ r.Timezone }).</p>
			<table>
				<thead><tr><th>Jam</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th></th></tr></thead>
				<tbody>
					for _, h := range r.ByHour {
						<tr>
							<td>{ fmt.Sprintf("%02d:00", h.Hour) }</td>
							<td class="num">{ Rupiah(h.NetSales) }</td>
							<td class="num">{ reportCount(h.Orders) }</td>
							<td><progress class="share" max={ hourMax(r) } value={ reportCount(h.NetSales) }></progress></td>
						</tr>
					}
					if len(r.ByHour) == 0 {
						<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
	<div class="card">
		<h2>Per produk</h2>
		if len(r.ByProduct) > reportProductLimit {
			<p class="sub">{ reportCount(int64(reportProductLimit)) } produk teratas dari { reportCount(int64(len(r.ByProduct))) }. Daftar lengkap ada di ekspor.</p>
		}
		<table>
			<thead><tr><th>Produk</th><th class="num">Qty</th><th class="num">Kotor</th><th class="num">Bersih</th><th class="num">HPP</th><th class="num">Cakupan HPP</th></tr></thead>
			<tbody>
				for _, p := range reportProducts(r) {
					<tr>
						<td>{ p.Name }</td>
						<td class="num">{ reportCount(p.Quantity) }</td>
						<td class="num">{ Rupiah(p.Revenue) }</td>
						<td class="num">{ Rupiah(p.NetSales) }</td>
						<td class="num">{ Rupiah(p.CostOfGoods) }</td>
						<td class="num">{ reportPct(p.Coverage() * 100) }</td>
					</tr>
				}
				if len(r.ByProduct) == 0 {
					<tr><td colspan="6" class="sub">Belum ada penjualan.</td></tr>
				}
			</tbody>
		</table>
	</div>
	if len(r.ByProductInCategory) > 0 {
		<div class="card">
			<h2>Item teratas per kategori</h2>
			<p class="sub">
				Jumlah item dalam satu kategori selalu sama dengan penjualan bersih kategori itu:
				keduanya berasal dari satu alokasi diskon, bukan dua pembulatan terpisah.
			</p>
			<table>
				<thead><tr><th>Kategori</th><th>Produk</th><th class="num">Qty</th><th class="num">Penjualan bersih</th></tr></thead>
				<tbody>
					for _, g := range r.ByProductInCategory {
						for i, p := range g.Products {
							<tr>
								<td>
									if i == 0 {
										{ groupLabel(g) }
									}
								</td>
								<td>{ p.Name }</td>
								<td class="num">{ reportCount(p.Quantity) }</td>
								<td class="num">{ Rupiah(p.NetSales) }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	}
	<div class="card">
		<h2>Audit diskon &amp; void</h2>
		<table>
			<thead><tr><th>Jenis</th><th>Keterangan</th><th class="num">Order</th><th class="num">Nilai</th></tr></thead>
			<tbody>
				for _, a := range r.Adjustments {
					<tr>
						<td>{ reporting.AdjustmentKindLabel(a.Kind) }</td>
						<td>{ reporting.AdjustmentLabel(a) }</td>
						<td class="num">{ reportCount(a.Count) }</td>
						<td class="num">{ Rupiah(a.Amount) }</td>
					</tr>
				}
				if len(r.Adjustments) == 0 {
					<tr><td colspan="4" class="sub">Tidak ada diskon, pembatalan, atau refund.</td></tr>
				}
			</tbody>
		</table>
	</div>
}

templ ExportsCard(list []reporting.Export, loc *time.Location) {
	<div id="exports" class="card" { exportPoll(list)... }>
		<h2>Ekspor terbaru</h2>
		<p class="sub">File disimpan 30 hari. Ekspor terjadwal dikirim lewat email sebagai tautan yang kedaluwarsa.</p>
		<table>
			<thead><tr><th>Dibuat</th><th>Periode</th><th>Outlet</th><th>Format</th><th>Status</th><th></th></tr></thead>
			<tbody>
				for _, e := range list {
					<tr>
						<td>{ localTime(e.CreatedAt, loc) }</td>
						<td>{ exportPeriod(e) }</td>
						<td>{ exportOutlet(e) }</td>
						<td>{ strings.ToUpper(e.Format) }</td>
						<td>
							if e.Status == reporting.ExportDone {
								<span class="badge on">{ exportStatusLabel(e) }</span>
							} else if e.Status == reporting.ExportFailed {
								<span class="badge off" title={ e.Error }>{ exportStatusLabel(e) }</span>
							} else {
								<span class="badge">{ exportStatusLabel(e) }</span>
							}
							if e.Scheduled && e.DeliveredAt != nil {
								<span class="hint">terkirim</span>
							} else if e.DeliveryError != "" {
								<span class="hint" title={ e.DeliveryError }>belum terkirim</span>
							}
						</td>
						<td style="text-align:right">
							if e.Status == reporting.ExportDone {
								<a href={ templ.URL("/backoffice/reports/exports/" + e.ID + "/download") }>Unduh ({ byteLabel(e.ByteSize) })</a>
							} else if e.Status == reporting.ExportFailed {
								<span class="hint">{ e.Error }</span>
							}
						</td>
					</tr>
				}
				if len(list) == 0 {
					<tr><td colspan="6" class="sub">Belum ada ekspor.</td></tr>
				}
			</tbody>
		</table>
	</div>
}

templ SchedulesPage(s Session, v ScheduleView) {
	@Shell("Jadwal laporan", s) {
		<p><a href="/backoffice/reports">← Laporan</a></p>
		<h1>Jadwal kirim laporan</h1>
		<p class="sub">
			Laporan dikirim pukul 06.00 waktu merchant, sesudah perhitungan ulang malam hari. Email berisi tautan
			unduhan yang kedaluwarsa, bukan lampiran.
		</p>
		@SchedulesCard(v)
	}
}

templ SchedulesCard(v ScheduleView) {
	<div id="schedules">
		<div class="card">
			<h2>Tambah jadwal</h2>
			<form class="grid" hx-post="/backoffice/reports/schedules" hx-target="#schedules" hx-swap="outerHTML">
				@Select(v.Form, "Frekuensi", "frequency", ReportFrequencyOptions)
				@Select(v.Form, "Format", "format", ReportFormatOptions)
				@Select(v.Form, "Outlet", "outlet", WithAllOutlets(v.Outlets))
				@TextArea(v.Form, "Penerima (pisahkan dengan koma, maksimal 10)", "recipients", templ.Attributes{"required": true})
				<div class="actions wide"><button type="submit" class="primary">Simpan jadwal</button></div>
			</form>
		</div>
		<div class="card">
			<table>
				<thead><tr><th>Frekuensi</th><th>Outlet</th><th>Format</th><th>Penerima</th><th>Kirim berikutnya</th><th>Status</th><th></th></tr></thead>
				<tbody>
					for _, sc := range v.Schedules {
						<tr>
							<td>{ frequencyLabel(sc.Frequency) }</td>
							<td>{ scheduleOutlet(sc) }</td>
							<td>{ strings.ToUpper(sc.Format) }</td>
							<td>{ strings.Join(sc.Recipients, ", ") }</td>
							<td>
								if sc.Active {
									{ localTime(sc.NextRunAt, v.Location) }
								} else {
									<span class="hint">dijeda</span>
								}
							</td>
							<td>
								@ActiveBadge(sc.Active)
							</td>
							<td style="text-align:right">
								if sc.Active {
									<button
										type="button"
										hx-post={ "/backoffice/reports/schedules/" + sc.ID + "/active" }
										hx-vals={ activeVals(false) }
										hx-target="#schedules"
										hx-swap="outerHTML"
									>Jeda</button>
								} else {
									<button
										type="button"
										hx-post={ "/backoffice/reports/schedules/" + sc.ID + "/active" }
										hx-vals={ activeVals(true) }
										hx-target="#schedules"
										hx-swap="outerHTML"
									>Aktifkan</button>
								}
								<button
									type="button"
									class="danger"
									hx-post={ "/backoffice/reports/schedules/" + sc.ID + "/delete" }
									hx-target="#schedules"
									hx-swap="outerHTML"
									hx-confirm="Hapus jadwal ini?"
								>Hapus</button>
							</td>
						</tr>
					}
					if len(v.Schedules) == 0 {
						<tr><td colspan="7" class="sub">Belum ada jadwal.</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ DashboardPage(s Session, v DashboardView) {
	@Shell("Dashboard", s) {
		@reportStyles()
		<h1>Dashboard</h1>
		<p class="sub">
			Dari rollup yang sama dengan laporan. Pembanding selalu memakai jumlah hari yang sama persis
			sebelum periode ini, bukan "bulan lalu" — Februari tidak boleh terlihat anjlok hanya karena
			lebih pendek.
		</p>
		<div class="card">
			<div class="filters">
				for _, p := range reporting.Periods {
					<a
						class={ periodClass(v.Preset, p) }
						href={ templ.SafeURL(dashboardQuery(v, p)) }
					>{ reporting.PeriodLabel(p) }</a>
				}
			</div>
			<form method="get" action="/backoffice/dashboard" class="filters">
				<input type="hidden" name="period" value="custom"/>
				@Field(v.Form, "Dari", "from", "date", templ.Attributes{"required": true})
				@Field(v.Form, "Sampai", "to", "date", templ.Attributes{"required": true})
				@Select(v.Form, "Outlet", "outlet", WithAllOutlets(v.Outlets))
				<button type="submit" class="primary">Rentang khusus</button>
			</form>
		</div>
		@DashboardTiles(v)
	}
}

templ DashboardTiles(v DashboardView) {
	// The auto-refresh carries the current period with it; without that the
	// poll would quietly drag the page back to today every thirty seconds.
	<div id="dashboard" hx-get={ dashboardTilesQuery(v) } hx-trigger="every 30s" hx-swap="outerHTML">
		if !v.HasReport {
			<div class="card"><p class="sub">Pilih periode dan outlet yang valid untuk melihat angkanya.</p></div>
		} else {
			<p class="hint">
				{ reportPeriod(v.Current) } · { reportOutlet(v.Current) } · dibandingkan dengan
				{ reportPeriod(v.Previous) }.
			</p>
			<div class="tiles">
				@reportTile("Penjualan bersih", Rupiah(v.Current.NetSales), deltaLabel(v.Current.NetSales, v.Previous.NetSales))
				@reportTile("Total penerimaan", Rupiah(v.Current.Revenue), deltaLabel(v.Current.Revenue, v.Previous.Revenue))
				@reportTile("Order", reportCount(v.Current.OrderCount), deltaLabel(v.Current.OrderCount, v.Previous.OrderCount))
				@reportTile("Rata-rata penjualan", Rupiah(v.Current.AverageOrder), deltaLabel(v.Current.AverageOrder, v.Previous.AverageOrder))
				@reportTile("Item terjual", reportCount(v.Current.ItemsSold), deltaLabel(v.Current.ItemsSold, v.Previous.ItemsSold))
				if v.ShowCosts {
					@reportTile("Laba kotor", Rupiah(v.Current.GrossProfit), deltaLabel(v.Current.GrossProfit, v.Previous.GrossProfit))
					@reportTile("Margin kotor", reportMargin(v.Current), "atas penjualan bersih")
				}
			</div>
			if v.Current.Incomplete() {
				<p class="notice">
					{ reportCount(v.Current.LegacySlices) } hari-outlet masih memakai rumus lama; waterfall
					belum lengkap sampai perhitungan ulang selesai.
				</p>
			}
			<div class="card">
				<h2>Waterfall penjualan</h2>
				<table>
					<tbody>
						<tr><td>Penjualan kotor</td><td class="num">{ Rupiah(v.Current.GrossSales) }</td></tr>
						<tr><td>Diskon</td><td class="num">−{ Rupiah(v.Current.AllDiscount) }</td></tr>
						<tr><td>Retur penjualan</td><td class="num">−{ Rupiah(v.Current.SalesReturns) }</td></tr>
						if v.Current.TaxIncluded != 0 {
							<tr><td>Pajak termasuk harga</td><td class="num">−{ Rupiah(v.Current.TaxIncluded) }</td></tr>
						}
						<tr><td><strong>Penjualan bersih</strong></td><td class="num"><strong>{ Rupiah(v.Current.NetSales) }</strong></td></tr>
						<tr><td>Pajak, service &amp; pembulatan</td><td class="num">+{ Rupiah(v.Current.Tax + v.Current.ServiceCharge + v.Current.Rounding) }</td></tr>
						<tr><td><strong>Total penerimaan</strong></td><td class="num"><strong>{ Rupiah(v.Current.Revenue) }</strong></td></tr>
					</tbody>
				</table>
			</div>
			<div class="report-grid">
				<div class="card">
					<h2>Perbandingan outlet</h2>
					<p class="sub">Periode yang sama untuk setiap cabang, diurutkan menurut penjualan bersih.</p>
					<table>
						<thead><tr><th>Outlet</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th></th></tr></thead>
						<tbody>
							for _, o := range v.Current.ByOutlet {
								<tr>
									<td>{ o.Label }</td>
									<td class="num">{ Rupiah(o.Net) }</td>
									<td class="num">{ reportCount(o.Count) }</td>
									<td><progress class="share" max={ outletMax(v.Current) } value={ reportCount(o.Net) }></progress></td>
								</tr>
							}
							if len(v.Current.ByOutlet) == 0 {
								<tr><td colspan="4" class="sub">Belum ada penjualan pada periode ini.</td></tr>
							}
						</tbody>
					</table>
				</div>
				<div class="card">
					<h2>Harian</h2>
					<table>
						<thead><tr><th>Tanggal</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th></th></tr></thead>
						<tbody>
							for _, d := range v.Current.Daily {
								<tr>
									<td>{ DateValue(d.Date) }</td>
									<td class="num">{ Rupiah(d.NetSales) }</td>
									<td class="num">{ reportCount(d.Orders) }</td>
									<td><progress class="share" max={ dailyMax(v.Current) } value={ reportCount(d.NetSales) }></progress></td>
								</tr>
							}
							if len(v.Current.Daily) == 0 {
								<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
							}
						</tbody>
					</table>
				</div>
				<div class="card">
					<h2>Per jam</h2>
					<table>
						<thead><tr><th>Jam</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th></th></tr></thead>
						<tbody>
							for _, h := range v.Current.ByHour {
								<tr>
									<td>{ fmt.Sprintf("%02d:00", h.Hour) }</td>
									<td class="num">{ Rupiah(h.NetSales) }</td>
									<td class="num">{ reportCount(h.Orders) }</td>
									<td><progress class="share" max={ hourMax(v.Current) } value={ reportCount(h.NetSales) }></progress></td>
								</tr>
							}
							if len(v.Current.ByHour) == 0 {
								<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
							}
						</tbody>
					</table>
				</div>
				<div class="card">
					<h2>Hari dalam minggu</h2>
					<table>
						<thead><tr><th>Hari</th><th class="num">Penjualan bersih</th><th class="num">Order</th><th class="num">Hari</th></tr></thead>
						<tbody>
							for _, w := range v.Current.ByWeekday {
								<tr>
									<td>{ reporting.Weekdays[w.Weekday] }</td>
									<td class="num">{ Rupiah(w.NetSales) }</td>
									<td class="num">{ reportCount(w.Orders) }</td>
									<td class="num">{ reportCount(w.Days) }</td>
								</tr>
							}
							if len(v.Current.ByWeekday) == 0 {
								<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
							}
						</tbody>
					</table>
				</div>
				<div class="card">
					<h2>Item teratas</h2>
					<table>
						<thead><tr><th>Produk</th><th class="num">Qty</th><th class="num">Penjualan bersih</th></tr></thead>
						<tbody>
							for i, p := range v.Current.ByProduct {
								if i < 10 {
									<tr>
										<td>{ p.Name }</td>
										<td class="num">{ reportCount(p.Quantity) }</td>
										<td class="num">{ Rupiah(p.NetSales) }</td>
									</tr>
								}
							}
							if len(v.Current.ByProduct) == 0 {
								<tr><td colspan="3" class="sub">Belum ada penjualan.</td></tr>
							}
						</tbody>
					</table>
				</div>
				<div class="card">
					<h2>Kategori</h2>
					<table>
						<thead><tr><th>Kategori</th><th class="num">Penjualan bersih</th><th class="num">Item</th><th class="num">Kontribusi</th></tr></thead>
						<tbody>
							for _, c := range v.Current.ByCategory {
								<tr>
									<td>{ reporting.CategoryLabel(c) }</td>
									<td class="num">{ Rupiah(c.Net) }</td>
									<td class="num">{ reportCount(c.Items) }</td>
									<td class="num">{ reportPct(c.ContributionPercent) }</td>
								</tr>
							}
							if len(v.Current.ByCategory) == 0 {
								<tr><td colspan="4" class="sub">Belum ada penjualan.</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<p class="hint">
				Data per { reportComputed(v.Current) }.
				if v.Current.PendingSlices > 0 {
					{ reportCount(v.Current.PendingSlices) } hari-outlet sedang diperbarui.
				}
			</p>
		}
	</div>
}

// ReportPrintPage is a complete document for the PDF renderer: no navigation,
// no scripts, styles inline.
templ ReportPrintPage(r reporting.Report) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<title>Laporan penjualan { r.BusinessName }</title>
			<style>
				body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #111; margin: 0; }
				h1 { font-size: 18px; margin: 0 0 4px; }
				h2 { font-size: 13px; margin: 0 0 6px; }
				table { width: 100%; border-collapse: collapse; }
				th, td { border-bottom: 1px solid #ddd; padding: 3px 6px; text-align: left; }
				.num { text-align: right; }
				.card { page-break-inside: avoid; margin: 0 0 12px; }
				.tiles { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin: 10px 0; }
				.tile { border: 1px solid #ddd; padding: 6px; }
				.value { font-size: 14px; font-weight: bold; }
				.sub, .hint { color: #555; }
				.notice { border-left: 3px solid #b45309; padding-left: 8px; }
				progress { display: none; }
			</style>
		</head>
		<body>
			<h1>Laporan penjualan { r.BusinessName }</h1>
			<p class="sub">{ reportPeriod(r) } · { reportOutlet(r) } · data per { reportComputed(r) }</p>
			@ReportBody(r)
		</body>
	</html>
}

// PublicMessage is a page for someone without a session: an e-mailed link that
// expired, say.
templ PublicMessage(title, message string) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · JustClick POS</title>
			<style>
				body { font-family: system-ui, sans-serif; background: #f6f7f9; color: #111; margin: 0; }
				main { max-width: 480px; margin: 12vh auto; background: #fff; border-radius: 12px; padding: 24px; }
			</style>
		</head>
		<body>
			<main>
				<h1>{ title }</h1>
				<p>{ message }</p>
			</main>
		</body>
	</html>
}
