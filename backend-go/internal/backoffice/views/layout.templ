package views

import "fmt"

func csrfHeaders(token string) string {
	return fmt.Sprintf(`{"X-CSRF-Token": %q}`, token)
}

templ Shell(title string, s Session) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · JustClick POS</title>
			<!-- No icon yet; declaring an empty one stops every page load from asking for /favicon.ico and logging a 404. -->
			<link rel="icon" href="data:,"/>
			@RailPreference()
			<script src="/backoffice/static/htmx.min.js"></script>
			@styles()
		</head>
		<body class="app" hx-headers={ csrfHeaders(s.CSRFToken) }>
			if s.Impersonation != nil {
				@impersonationBanner(*s.Impersonation, s.CSRFToken)
			}
			<div class="layout">
				@Sidebar("JustClick POS", "/backoffice/dashboard", false, s.NavView())
				<div class="pane">
					<header class="topbar">
						<button
							type="button"
							class="rail-toggle"
							aria-label="Buka atau tutup menu"
							aria-expanded="true"
							onclick="toggleRail()"
						>
							@NavIcon("menu")
						</button>
						<div class="crumb">{ s.BusinessName }</div>
						<div class="who">
							<a href="/backoffice/account">{ s.EmployeeName }</a> <span>· { RoleLabel(s.Role) }</span>
							<form method="post" action="/backoffice/logout">
								<input type="hidden" name="gorilla.csrf.Token" value={ s.CSRFToken }/>
								<button type="submit" class="link">Keluar</button>
							</form>
						</div>
					</header>
					<main>
						{ children... }
					</main>
				</div>
			</div>
			<div id="toast" class="toast" hidden></div>
			@toastScript()
			@RailScript()
		</body>
	</html>
}

// toastScript shows the message a handler sends in HX-Trigger, and — just as
// important — says something when a request fails. HTMX does not swap a 4xx or
// 5xx response, so without this a refused click looks like a click that did
// nothing at all.
templ toastScript() {
	<script>
		(function () {
			var box = document.getElementById("toast"), timer;
			function show(message, bad) {
				box.textContent = message;
				box.className = bad ? "toast bad" : "toast";
				box.hidden = false;
				clearTimeout(timer);
				timer = setTimeout(function () { box.hidden = true; }, 3500);
			}
			document.body.addEventListener("toast", function (e) { show(e.detail.value, false); });
			document.body.addEventListener("toastError", function (e) { show(e.detail.value, true); });
			document.body.addEventListener("htmx:responseError", function (e) {
				var status = e.detail.xhr.status;
				show(status === 403 ? "Anda tidak punya izin untuk tindakan ini."
					: status === 404 ? "Data tidak ditemukan. Muat ulang halaman."
					: "Terjadi kesalahan di server. Coba lagi.", true);
			});
			document.body.addEventListener("htmx:sendError", function () {
				show("Tidak terhubung ke server.", true);
			});
		})();
	</script>
}

templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · JustClick POS</title>
			<!-- No icon yet; declaring an empty one stops every page load from asking for /favicon.ico and logging a 404. -->
			<link rel="icon" href="data:,"/>
			@styles()
		</head>
		<body class="centered">
			{ children... }
		</body>
	</html>
}

templ styles() {
	<style>
		:root { --ink:#101828; --muted:#667085; --line:#e4e7ec; --bg:#f8f9fb; --blue:#1e40af; --danger:#b42318; --ok:#067647; }
		* { box-sizing:border-box; }
		body { margin:0; font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--ink); background:var(--bg); }
		body.centered { display:grid; place-items:center; min-height:100vh; }
		/* ---- shell: fixed sidebar, scrolling pane ------------------------ */
		.layout { display:flex; align-items:stretch; min-height:100vh; }
		.pane { flex:1; min-width:0; display:flex; flex-direction:column; }
		.topbar { display:flex; align-items:center; gap:16px; padding:12px 24px; background:#fff; border-bottom:1px solid var(--line); }
		.crumb { flex:1; font-weight:600; color:var(--ink); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
		.who { display:flex; align-items:center; gap:12px; color:var(--muted); font-size:13px; }
		main { padding:24px; max-width:1100px; margin:0 auto; width:100%; }

		/* ---- sidebar ----------------------------------------------------- */
		.side { width:244px; flex:0 0 244px; background:#fff; border-right:1px solid var(--line); display:flex; flex-direction:column; position:sticky; top:0; height:100vh; overflow-y:auto; transition:width .15s ease, flex-basis .15s ease; }
		.side-head { padding:16px 18px; border-bottom:1px solid var(--line); }
		.side-head .brand { display:flex; align-items:center; gap:8px; font-weight:650; color:var(--blue); text-decoration:none; white-space:nowrap; }
		.side-nav { padding:10px; display:flex; flex-direction:column; gap:2px; }
		.ic { width:20px; height:20px; flex:0 0 20px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
		.nav-link, .nav-group > summary { display:flex; align-items:center; gap:10px; padding:9px 11px; border-radius:8px; color:var(--ink); text-decoration:none; font-size:14px; cursor:pointer; }
		.nav-link:hover, .nav-group > summary:hover { background:var(--bg); }
		.nav-link.is-active { background:#eef2ff; color:var(--blue); font-weight:600; }
		.nav-group > summary { list-style:none; color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.05em; }
		.nav-group > summary::-webkit-details-marker { display:none; }
		.chev { margin-left:auto; width:7px; height:7px; border-right:1.6px solid currentColor; border-bottom:1.6px solid currentColor; transform:rotate(45deg); transition:transform .15s ease; }
		.nav-group[open] > summary .chev { transform:rotate(-135deg); }
		.nav-sub { display:flex; flex-direction:column; gap:2px; margin:2px 0 6px; }
		/* Indented to the icon column, so a sub-item reads as belonging to its
		   group rather than as another top-level destination. */
		.nav-link.sub { padding-left:41px; font-size:14px; color:var(--ink); }

		/* ---- collapsed to an icon rail ----------------------------------- */
		html.rail .side { width:64px; flex-basis:64px; }
		html.rail .nav-text, html.rail .chev, html.rail .env-tag { display:none; }
		html.rail .side-head { padding:16px 0; text-align:center; }
		html.rail .nav-link, html.rail .nav-group > summary { justify-content:center; padding:10px 0; }
		/* A group's items stay reachable on the rail: the icon is the group, the
		   list below it is still the group's, just without the heading text. */
		html.rail .nav-link.sub { padding:7px 0; font-size:11px; text-align:center; justify-content:center; }
		html.rail .nav-link.sub .nav-text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:56px; }
		.rail-toggle { border:0; background:none; padding:6px; color:var(--muted); display:flex; align-items:center; border-radius:7px; }
		.rail-toggle:hover { background:var(--bg); color:var(--ink); }

		/* ---- narrow screens: the rail is the only sensible default ------- */
		@media (max-width:820px) {
			.side { width:64px; flex-basis:64px; }
			.side .nav-text, .side .chev, .side .env-tag { display:none; }
			.side .nav-link, .side .nav-group > summary { justify-content:center; padding:10px 0; }
			main { padding:16px; }
		}
		h1 { font-size:20px; margin:0 0 4px; }
		h2 { font-size:16px; margin:0 0 12px; }
		.sub { color:var(--muted); margin:0 0 20px; font-size:14px; }
		.head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
		.card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:20px; margin-bottom:20px; }
		table { width:100%; border-collapse:collapse; }
		th,td { text-align:left; padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:middle; }
		th { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
		td.num, th.num { text-align:right; font-variant-numeric:tabular-nums; }
		tr:last-child td { border-bottom:0; }
		a { color:var(--blue); }
		button, a.button { font:inherit; cursor:pointer; border-radius:7px; border:1px solid var(--line); background:#fff; padding:7px 12px; color:var(--ink); text-decoration:none; display:inline-block; }
		button.primary, a.button.primary { background:var(--blue); border-color:var(--blue); color:#fff; }
		button.danger { color:var(--danger); border-color:#f5c2bd; }
		button.link { border:0; background:none; color:var(--muted); padding:0; text-decoration:underline; }
		.badge { font-size:12px; padding:2px 8px; border-radius:999px; background:var(--bg); border:1px solid var(--line); color:var(--muted); white-space:nowrap; }
		.badge.off { color:var(--danger); border-color:#f5c2bd; }
		.badge.on { color:var(--ok); border-color:#abefc6; }
		form.stack { display:grid; gap:14px; width:340px; }
		form.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; align-items:start; }
		form.grid .wide { grid-column:1/-1; }
		form.inline { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; }
		form.inline label { min-width:140px; }
		.actions { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
		label { display:grid; gap:6px; font-size:13px; color:var(--muted); }
		label.check { display:flex; gap:8px; align-items:center; color:var(--ink); font-size:14px; }
		input, select, textarea { font:inherit; padding:9px 11px; border:1px solid var(--line); border-radius:7px; background:#fff; color:var(--ink); }
		input[type=checkbox] { width:16px; height:16px; padding:0; }
		.invalid input, .invalid select, .invalid textarea { border-color:var(--danger); }
		.error { color:var(--danger); font-size:13px; margin:0; }
		.hint { color:var(--muted); font-size:12px; }
		.code { font:600 26px/1 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.14em; padding:14px 0; }
		.notice { background:#fffaeb; border:1px solid #fedf89; border-radius:8px; padding:12px 14px; font-size:13px; }
		.pager { display:flex; gap:10px; justify-content:flex-end; margin-top:12px; }
		.group { border:1px solid var(--line); border-radius:8px; padding:12px 14px; margin-bottom:10px; }
		.group .options { display:flex; flex-wrap:wrap; gap:6px 18px; margin:8px 0 0 24px; }
		.row { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; padding:10px 0; border-bottom:1px solid var(--line); }
		.row:last-child { border-bottom:0; }
		.toast { position:fixed; right:20px; bottom:20px; background:var(--ink); color:#fff; padding:10px 14px; border-radius:8px; font-size:14px; max-width:380px; }
		.toast.bad { background:var(--danger); }
		.product-image { display:block; max-width:240px; max-height:240px; border:1px solid var(--line); border-radius:8px; margin-bottom:14px; background:var(--bg); }
		.impersonation { position:sticky; top:0; z-index:20; display:flex; gap:16px; align-items:center; flex-wrap:wrap; background:var(--danger); color:#fff; padding:10px 24px; font-size:14px; }
		.impersonation strong { font-weight:650; }
		.impersonation form { margin-left:auto; }
		.impersonation button { background:#fff; color:var(--danger); border-color:#fff; font-weight:600; }
	</style>
}

// Styles is the panel's stylesheet, for the platform panel's own pages.
templ Styles() {
	@styles()
}

// impersonationBanner cannot be closed or scrolled away. Support inside a
// merchant's Backoffice must never look like the owner working normally — to
// the support engineer, or to anyone looking over their shoulder.
templ impersonationBanner(b ImpersonationBanner, csrfToken string) {
	<div class="impersonation" role="alert">
		<span><strong>MODE SUPPORT</strong> · { b.AdminName } masuk sebagai { b.EmployeeName }</span>
		<span>Alasan: { b.Reason }</span>
		<span>Berakhir { b.EndsAt }</span>
		<form method="post" action="/backoffice/impersonation/end">
			<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
			<button type="submit">Akhiri impersonasi</button>
		</form>
	</div>
}

// Sidebar is the navigation for both panels: the merchant Backoffice and the
// platform panel render the same chrome so support staff move between them
// without relearning where anything is.
//
// Groups are <details>, not a JavaScript accordion: the browser already knows
// how to open and close a disclosure, keyboard and screen reader included, and
// a group holding the current page arrives already open rather than opening
// after a script runs.
templ Sidebar(brand, home string, platform bool, nav NavView) {
	<aside class={ "side", templ.KV("platform", platform) }>
		<div class="side-head">
			<a class="brand" href={ templ.SafeURL(home) }>
				{ brand }
				if platform {
					<span class="env-tag">PLATFORM</span>
				}
			</a>
		</div>
		<nav class="side-nav">
			for _, group := range nav.Groups {
				if group.Label == "" {
					for _, item := range group.Items {
						<a
							class={ "nav-link", templ.KV("is-active", item.Href == nav.Active) }
							href={ templ.SafeURL(item.Href) }
							title={ item.Label }
						>
							@NavIcon(group.Icon)
							<span class="nav-text">{ item.Label }</span>
						</a>
					}
				} else {
					<details class="nav-group" open?={ nav.Open(group) }>
						<summary title={ group.Label }>
							@NavIcon(group.Icon)
							<span class="nav-text">{ group.Label }</span>
							<span class="chev" aria-hidden="true"></span>
						</summary>
						<div class="nav-sub">
							for _, item := range group.Items {
								<a
									class={ "nav-link", "sub", templ.KV("is-active", item.Href == nav.Active) }
									href={ templ.SafeURL(item.Href) }
								>
									<span class="nav-text">{ item.Label }</span>
								</a>
							}
						</div>
					</details>
				}
			}
		</nav>
	</aside>
}

// railScript is the only JavaScript the navigation needs: remember whether the
// person collapsed it. Every page here is a full load, so without persistence
// the sidebar would spring back open on every click.
//
// The state is read before first paint in Shell's <head>-adjacent script below,
// so a collapsed rail never flashes open.
templ RailScript() {
	<script>
		function toggleRail() {
			var collapsed = document.documentElement.classList.toggle("rail");
			var button = document.querySelector(".rail-toggle");
			if (button) button.setAttribute("aria-expanded", collapsed ? "false" : "true");
			try { localStorage.setItem("jc-rail", collapsed ? "1" : "0"); } catch (e) { /* private mode */ }
		}
		(function () {
			var button = document.querySelector(".rail-toggle");
			if (button && document.documentElement.classList.contains("rail")) {
				button.setAttribute("aria-expanded", "false");
			}
		})();
	</script>
}

// railPreference runs before the body is painted. Reading the stored choice
// after render would show the sidebar wide for one frame and then snap it
// shut on every single page load.
templ RailPreference() {
	<script>
		try {
			if (localStorage.getItem("jc-rail") === "1") {
				document.documentElement.classList.add("rail");
			}
		} catch (e) { /* private mode: start expanded */ }
	</script>
}

// navIcon keeps the collapsed rail meaningful. Inline rather than a sprite or
// an icon font: two files fewer to serve, and nothing to load before the menu
// is usable.
templ NavIcon(name string) {
	switch name {
		case "home":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg>
		case "chart":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg>
		case "book":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 0-3 3z"></path><path d="M18 7h2v13h-2"></path></svg>
		case "box":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5V17L12 21l-9-4V7.5z"></path><path d="M3 7.5 12 12l9-4.5M12 12v9"></path></svg>
		case "people":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"></circle><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"></path><path d="M16 5.5a3.2 3.2 0 0 1 0 6M17 14.8c2.4.5 4 2.4 4 5.2"></path></svg>
		case "store":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"></path><path d="M3 9l1.5-5h15L21 9M9 21v-6h6v6"></path></svg>
		case "building":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v17"></path><path d="M15 10h3a1 1 0 0 1 1 1v10M3 21h18M9 7h2M9 11h2M9 15h2"></path></svg>
		case "log":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><path d="M14 3v6h6M9 13h7M9 17h5"></path></svg>
		case "pulse":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h4l3 8 4-16 3 8h6"></path></svg>
		case "menu":
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
		default:
			<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle></svg>
	}
}
