# Copy to .env and fill in. .env is gitignored.

POSTGRES_USER=justclick
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=justclick

REDIS_PASSWORD=change-me-locally
REDIS_MAXMEMORY=512mb

# Three credentials, on purpose. The API must not be able to bypass row-level
# security, because PostgreSQL exempts superusers and BYPASSRLS roles from
# every policy silently — the first symptom would be one merchant reading
# another's rows. The process refuses to start if these are wired the wrong way.
#
# Apply these passwords with: justclick roles set-password
APP_DB_PASSWORD=change-me-locally
UNSCOPED_DB_PASSWORD=change-me-locally

# Tenant-scoped. Cannot bypass RLS. Serves every request.
DATABASE_URL=postgres://justclick_app:change-me-locally@127.0.0.1:5433/justclick?sslmode=disable
# The escape hatch. Deliberately can, for the handful of lookups that resolve
# an identity before any tenant is known (a device bearer token, a login email).
UNSCOPED_DATABASE_URL=postgres://justclick_unscoped:change-me-locally@127.0.0.1:5433/justclick?sslmode=disable
# Owns the schema and runs DDL. Never present in the serving process.
MIGRATE_DATABASE_URL=postgres://justclick:change-me-locally@127.0.0.1:5433/justclick?sslmode=disable

REDIS_URL=redis://:change-me-locally@127.0.0.1:6379/0

# Keys activation-code fingerprints and the Backoffice CSRF secret. Rotating it
# invalidates every outstanding code, which is the intended blast radius.
APP_KEY=change-me-locally

# Loopback on purpose. A bare ":9000" binds every interface, which puts
# /backoffice and /platform on the local network over plain HTTP, beside the
# door Caddy locks. Compose overrides this because there the binding is the
# Docker network, not the host.
HTTP_ADDR=127.0.0.1:9000

# Whether a reverse proxy in front of this process may be believed about the
# scheme the BROWSER used (X-Forwarded-Proto). Leave false when you reach this
# process directly; set true only when Caddy — or another ingress that
# overwrites the header — is the sole way in.
#
# Getting it wrong is silent and expensive: behind TLS with this false, the
# browser sends Origin: https://… while the server compares it against http,
# and every form POST is refused with "Forbidden - origin invalid".
TRUST_PROXY=false
LOG_LEVEL=debug
ENVIRONMENT=local

# How often a till polls /sync/changes. Served to the fleet in every response
# rather than compiled into the app, so an incident can widen the interval
# without waiting on an app-store review.
SYNC_POLL_INTERVAL=60s

# Uploaded product images. Compose sets both for the api container; these are
# for `justclick serve` run directly. Leave MEDIA_PUBLIC_BASE_URL unset locally
# to have this process serve /media itself; outside ENVIRONMENT=local it is
# required and must be https, because the till refuses plain http.
MEDIA_DIR=var/media
# MEDIA_PUBLIC_BASE_URL=https://pos.example.id/media

# Report exports (Fase 7). Files are private; the API serves them to signed-in
# employees and to e-mailed links that expire. PUBLIC_BASE_URL is the origin
# those links start with — required, and https, outside ENVIRONMENT=local.
REPORTS_DIR=var/reports
# PUBLIC_BASE_URL=https://pos.example.id
# PDF exports render through a gotenberg sidecar (docker compose --profile reports).
# GOTENBERG_URL=http://127.0.0.1:3000
# Scheduled reports are mailed as links. Unset, the export is still made and
# the Backoffice says it was not sent.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=laporan@pos.example.id

# ---- Fase 9: metrics, tuning and the observability profile ------------------

# Where Prometheus scrapes this process. Its own listener, never a route on the
# public one: /metrics names every internal queue. Compose does not publish it
# and Caddy does not proxy it. Empty disables publishing entirely.
METRICS_ADDR=127.0.0.1:9090

# Pool ceilings, sized against PostgreSQL's max_connections (200) rather than
# against the container's CPU count, which is what pgx would otherwise use — on
# a two-vCPU box that would be four connections for the whole API, and the
# symptom is latency with no slow query behind it.
#
#   instances x (PG_MAX_CONNS + PG_UNSCOPED_MAX_CONNS) + worker + psql < 200
PG_MAX_CONNS=25
PG_UNSCOPED_MAX_CONNS=10
PG_MIN_CONNS=2

# PostgreSQL tuning, read by docker-compose.yml. The values below suit a
# development laptop; the pilot box (8 vCPU / 32 GB) wants the plan's numbers:
# PG_SHARED_BUFFERS=8GB, PG_EFFECTIVE_CACHE_SIZE=22GB, PG_WORK_MEM=12MB,
# PG_MAINTENANCE_WORK_MEM=2GB, PG_MAX_WAL_SIZE=8GB.
# synchronous_commit is NOT configurable here on purpose: it is money.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=12MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_WAL_SIZE=4GB

# docker compose --profile observability up -d
#
# postgres_exporter connects as justclick_metrics, a role holding pg_monitor
# and no table grant at all (migration 019). Apply this password with
# `justclick roles set-password`, which picks it up only when it is set.
METRICS_DB_PASSWORD=change-me-locally
# Grafana is published on 127.0.0.1:3000 only. Unset, it falls back to
# admin/admin — set it anywhere that is not a laptop.
GRAFANA_PASSWORD=change-me-locally
