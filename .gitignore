# Root-level ignores for the monorepo.
# Flutter/Dart-specific ignores live in mobile/.gitignore, scoped to that project.

# OS
.DS_Store
Thumbs.db

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Claude Code machine-local settings (permissions are per-machine, not per-repo)
.claude/settings.local.json
.claude/worktrees/

# Build artifacts must never be committable from the repo root. These only
# appear here if a Flutter/Dart command is run from the wrong directory (the
# project root is mobile/, not this one), or as leftovers from the pre-monorepo
# layout — either way they are regenerable and must stay out of git.
/.dart_tool/
/.flutter-plugins-dependencies
/build/
/flutter_*.log
