<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      The local Caddy development gateway is intentionally HTTP at
      http://10.0.2.2:8090 for the Android emulator. Android 9+ blocks
      cleartext traffic by default, so allow it in DEBUG only. This manifest
      is not packaged in profile or release builds; deployed tills must use
      HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
